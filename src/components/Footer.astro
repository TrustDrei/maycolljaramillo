---
import { SITE, CONTACT_CTA } from '../config/site';
import { PERSON } from '../config/person';
import { NAV_LINKS } from '../data/navigation';
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const lang = Astro.props.lang ?? 'es';
const links = NAV_LINKS[lang];
const secondaryLinks = [
  { href: '/privacy', label: lang === 'es' ? 'Privacidad' : 'Privacy' },
  { href: '/terms', label: lang === 'es' ? 'Términos' : 'Terms' }
];
---

<footer class="mt-16 border-t-[3px] border-ink bg-panel px-4 py-14 text-sm text-muted">
  <div class="page-width space-y-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center overflow-hidden border-2 border-ink bg-panel-strong">
          <img
            src="/images/logo-128.png"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <div>
          <p class="text-xl font-extrabold uppercase tracking-tight text-foreground">{PERSON.shortName}</p>
          <p class="text-sm font-semibold text-muted">
            {lang === 'es'
              ? 'SEO técnico, accesibilidad y automatización'
              : 'Technical SEO, accessibility, automation'}
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          class="btn btn-primary"
          href={CONTACT_CTA.primary.href}
        >
          <Icon name="whatsapp" label="WhatsApp" />
          {lang === 'es' ? 'Hablar ahora' : 'Chat now'}
        </a>
        <a
          class="btn btn-ghost"
          href={`mailto:${SITE.email}`}
        >
          {lang === 'es' ? 'Correo' : 'Email'}
        </a>
        <a
          class="btn btn-ghost"
          href={SITE.social.github}
          target="_blank"
          rel="noopener"
        >
          <Icon name="github" label="GitHub" />
          GitHub
        </a>
        <a
          class="btn btn-ghost"
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="eyebrow">{lang === 'es' ? 'Mapa' : 'Site'}</p>
        <ul class="mt-3 space-y-2">
          {links.map((item) => (
            <li>
              <a
                class="font-semibold text-foreground hover:text-accent"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
        <ul class="mt-3 space-y-2 text-foreground/80">
          <li>
            <a
              class="font-semibold text-foreground hover:text-accent"
              href={`mailto:${SITE.email}`}
            >
              {SITE.email}
            </a>
          </li>
          <li>
            <a
              class="font-semibold text-foreground hover:text-accent"
              href={`tel:${SITE.phone.replace(/\s+/g, '')}`}
            >
              {SITE.phone}
            </a>
          </li>
          <li>
            <span class="px-1 py-1 text-foreground/70">
              {lang === 'es' ? 'Managua (UTC-6)' : 'Managua (UTC-6)'}
            </span>
          </li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">{lang === 'es' ? 'Legal' : 'Legal'}</p>
        <ul class="mt-3 space-y-2">
          {secondaryLinks.map((item) => (
            <li>
              <a
                class="font-semibold text-foreground hover:text-accent"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">
          {lang === 'es' ? 'Disponibilidad' : 'Availability'}
        </p>
        <ul class="mt-3 space-y-2 text-foreground/80">
          <li>{lang === 'es' ? 'Respuesta <24h hábiles' : '<24h response (business)'}</li>
          <li>{lang === 'es' ? 'Proyectos LATAM / UE / US' : 'Projects LATAM / EU / US'}</li>
          <li>{lang === 'es' ? 'SEO técnico, performance, accesibilidad' : 'Technical SEO, performance, accessibility'}</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 text-xs text-muted/85 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {PERSON.fullName}</p>
      <p>
        {lang === 'es'
          ? 'Hecho con Astro + Tailwind · criterios CWV, SEO, accesibilidad'
          : 'Built with Astro + Tailwind · CWV, SEO, accessibility'}
      </p>
    </div>
  </div>
</footer>

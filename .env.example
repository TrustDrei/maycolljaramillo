RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
CONTACT_TO=maycolljaramillo01@gmail.com
# Optional shared secret to validate requests (leave empty to disable)
CONTACT_ACCESS_KEY=
# OJO: todo lo que empieza por PUBLIC_ se compila dentro del bundle del cliente,
# así que esta copia es legible por cualquiera y NO protege el endpoint.
# Solo sirve para que el formulario pueda pasar el check de CONTACT_ACCESS_KEY.
# La protección real es el honeypot + el rate limit de api/contact.ts.
PUBLIC_CONTACT_ACCESS_KEY=
# Override the contact endpoint (defaults to /api/contact)
PUBLIC_CONTACT_ENDPOINT=
# Optional site/base overrides
SITE_URL=https://maycolljaramillo.com
BASE_PATH=/
